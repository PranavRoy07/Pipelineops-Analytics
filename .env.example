# Environment Variables Template for PipelineOps
# Copy this file to .env and adjust values if running in production

# Database Configuration (Leave empty to use built-in SQLite: clean_data/pipelineops.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pipelineops

# Alerting Webhook (Slack, Discord, or generic incoming webhook)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here

# AWS Credentials (Optional, for Phase 3 S3 data lake storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=pipelineops-analytics-lake
